# TEMPLATE sway config for the headless E2E compositor.
#
# sway configs cannot expand environment variables, so this file is a template:
# compositor.sh substitutes @OUTPUT@ / @WIDTH@ / @HEIGHT@ / @APP_ID@ from
# E2E_OUTPUT / E2E_WIDTH / E2E_HEIGHT / E2E_APP_ID and writes the result to
# $E2E_RUNTIME_DIR/sway.rendered.config, which is what `sway -c` actually loads.
# That keeps E2E_WIDTH/E2E_HEIGHT a single point of truth.  (Set E2E_SWAY_CONFIG
# to a file of your own to skip templating and use it verbatim.)
#
# This config REPLACES the system config entirely, so anything not mentioned
# here simply does not exist: no bar, no wallpaper, no keybindings, no
# autostarted programs.
#
# The compositor runs on the wlroots headless backend (WLR_BACKENDS=headless),
# so the single output is named HEADLESS-1 and there are no real input devices.

### Output ####################################################################

# `mode` and `resolution`/`res` are aliases (sway-output(5)).  Headless outputs
# have an empty mode list, and sway falls back to a custom mode automatically in
# that case, so a bare `mode WxH` is enough; `--custom` is accepted too and is
# left here as a comment in case a future sway needs it explicitly.
output @OUTPUT@ mode @WIDTH@x@HEIGHT@
# output @OUTPUT@ mode --custom @WIDTH@x@HEIGHT@

# scale 1 keeps logical coordinates == device pixels, which is what makes
# `ui.sh warp/click` coordinates line up with `ui.sh shot` pixels.
output @OUTPUT@ scale 1
output @OUTPUT@ position 0 0
output @OUTPUT@ enable
# Never blank the output; screenshots must work at any time.
# (`dpms on` is the deprecated alias of `power on`.)
output @OUTPUT@ power on

# No `output ... bg` on purpose: setting a background would require swaybg to be
# installed.  Sway paints its own plain default backdrop instead.

### Chrome ####################################################################

# No `bar { ... }` block at all => no swaybar process, nothing overlapping the
# app, and the window rect is the full @WIDTH@x@HEIGHT@.
default_border none
default_floating_border none
hide_edge_borders both
gaps inner 0
gaps outer 0
smart_borders off

# The app should own the whole output so screen coordinates == window
# coordinates.  app_id comes from the Wayland xdg-shell toplevel, and sway
# criteria are regexes -- @APP_ID@ is `.*` (fullscreen everything) when
# E2E_APP_ID is unset.
for_window [app_id="@APP_ID@"] fullscreen enable
# Belt and braces: anything that shows up floating gets no decoration either.
for_window [floating] border none

### Input #####################################################################

# There are no physical input devices; sway's own cursor is driven over IPC with
# `swaymsg seat seat0 cursor ...` (see ui.sh).  focus_follows_mouse makes the
# surface under the synthetic cursor take keyboard focus, which is what wtype
# needs.
focus_follows_mouse yes
mouse_warping none
focus_wrapping no

### Misc ######################################################################

# Assume the app under test is Wayland-native; refusing Xwayland avoids pulling
# in an X server and keeps DISPLAY meaningless inside the E2E session.  If you
# must drive an X11 app, comment this out -- but consider an Xvfb-based harness
# instead.
xwayland disable

# No idle/lock/dpms behaviour: swayidle and swaylock are simply never started,
# and nothing here schedules output power changes.

# No `exec`/`exec_always` lines: app.sh starts the app separately so its
# lifetime and logs can be managed independently of the compositor.

# Deliberately no keybindings.  If you need an escape hatch while poking at a
# VNC session (`compositor.sh start --vnc`), uncomment the next line.
# bindsym Mod4+Shift+e exit
